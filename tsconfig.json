{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "@padlownia/domain": ["./packages/domain/src/index.ts"],
      "@padlownia/database": ["./packages/database/src/index.ts"]
    }
  },
  "include": ["apps/worker/**/*.ts", "packages/**/*.ts", "tests/**/*.ts", "vitest.config.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "apps/web", "tests/web"]
}
