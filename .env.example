# Template only. Never commit populated environment files.
# Worker loads REPOSITORY_ROOT/.env. Next.js loads apps/web/.env.local.
# Prefer a secure process environment. Give the web process only its reader settings.
# See docs/development/SETUP.md before enabling Supabase mode.

APP_ENV=development
CATALOGUE_MODE=fixture
# CATALOGUE_MODE=snapshot reads a local JSON export of published_catalogue() (development only).
# Keep the export in the ignored .local/ folder. Absolute path or relative to the repository root.
CATALOGUE_SNAPSHOT_PATH=
NEXT_TELEMETRY_DISABLED=1

# Tryb deweloperski interfejsu: ustaw 1, aby pokazać ślad pochodzenia danych (ID obserwacji,
# ścieżka źródłowa, UUID wydania), etykietę środowiska i link do galerii komponentów.
# Puste lub inne wartości = widok użytkownika. Nie wpływa na dane ani na bezpieczeństwo.
SHOW_DEV_DETAILS=

# Optional server-only path to a reviewed image-rights manifest (version 1).
# Missing or invalid approval means no product photo. See IMAGE_ASSET_POLICY.md.
CATALOGUE_IMAGE_MANIFEST=

# Cloud mode requires a project explicitly confirmed as development.
# Replace placeholders only in an ignored local file or secure environment.
DEV_SUPABASE_CONFIRMED=false
DEV_SUPABASE_PROJECT_REF=YOUR_CONFIRMED_DEV_PROJECT_REF
SUPABASE_URL=https://YOUR_CONFIRMED_DEV_PROJECT_REF.supabase.co

# Optional public CA certificate from this verified project's dashboard.
# Needed when its CA is absent from Node's trust store. Keep TLS verification on.
# Set a quoted PEM value in the ignored file, preserving its certificate newlines.
SUPABASE_DB_CA_PEM=""

# Server-side web reader only. Never prefix any credential with NEXT_PUBLIC_.
WEB_DATABASE_URL=postgresql://padlownia_web:YOUR_URL_ENCODED_READER_PASSWORD@db.YOUR_CONFIRMED_DEV_PROJECT_REF.supabase.co:5432/postgres?sslmode=verify-full

# Worker only: distinct restricted login; never the postgres owner login.
DEV_DATABASE_URL=postgresql://padlownia_ingest:YOUR_URL_ENCODED_WORKER_PASSWORD@db.YOUR_CONFIRMED_DEV_PROJECT_REF.supabase.co:5432/postgres?sslmode=verify-full

# Worker only: privileged project secret key (sb_secret_...), NOT a bucket-scoped key.
# Needed for cloud snapshots/originals; opaque secrets use the apikey header only.
# A supported legacy JWT service key uses apikey plus Bearer instead.
# Do not put this key in apps/web/.env.local, browser code, commands or logs.
SUPABASE_STORAGE_KEY=YOUR_AUTHORIZED_DEV_STORAGE_KEY

# Optional public project key for the anonymous-role Storage denial probe.
# This does not authorize private reads/writes; never put a secret key here.
SUPABASE_PUBLISHABLE_KEY=

# Browser tests default to installed Edge. Use chromium after installing its binary.
# PLAYWRIGHT_CHANNEL=chromium
